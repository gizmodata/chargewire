---
// The landing page opens with the Chargewire banner, which carries the name: no title above it.
import Default from '@astrojs/starlight/components/PageTitle.astro';
const isHome = Astro.locals.starlightRoute.id === '' || Astro.locals.starlightRoute.id === 'index';
---

{isHome ? <h1 id="_top" class="sr-only">{Astro.locals.starlightRoute.entry.data.title}</h1> : <Default />}
